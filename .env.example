# Copia este archivo a .env.local y rellena los valores reales.
# .env.local está ignorado por git: los valores reales NUNCA se suben al repositorio.

# Supabase Auth de las cuentas reales (DN-13 §8.2 en Arca-back). Solo se usan con NEXT_PUBLIC_WEBAPP_ENABLED=true.
# URL del proyecto (Dashboard > Project Settings > API). En local: la API_URL de `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable (sb_publishable_...), la única clave de Supabase que puede ir en el front. Sustituye a la antigua
# NEXT_PUBLIC_SUPABASE_ANON_KEY, que ya no se lee. NUNCA una clave secreta (sb_secret_...): el build falla si alguna
# clave secreta de Supabase o de Stripe acaba en el bundle.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Webapp con cuentas reales (Supabase Auth). Sin definir o false: production no ofrece la webapp ("Keep these results"
# no sale y el login dice que no está disponible), y live-debug usa las cuentas simuladas del back. true: production y
# live-debug inician sesión con Supabase; el back tiene que estar encendido con la webapp real (WEBAPP_ENABLED=true en
# producción, WEBAPP_PROVIDERS=real en live-debug). En mock no se admite: next dev y next build se paran.
# En Vercel solo se pone en el entorno Production y solo después de encender el back (DN-13 §7.6, §8.3).
# NEXT_PUBLIC_WEBAPP_ENABLED=

# OPCIONAL. En producción no hace falta: por defecto se usa https://arcacover.com.
# Solo se rellena en previews o staging, para que la imagen que se ve al
# compartir el enlace apunte a ese entorno y no al dominio real.
# Formato: con https y sin barra final.
# Se deja comentada: vacía rompe todas las páginas (layout.tsx hace new URL("")).
# NEXT_PUBLIC_SITE_URL=

# Required explicit API origin. This isolated fork never falls back to production.
# Run the paired Arca-back checkout locally. No live API or paid service is needed.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Developer mode, same value as ARCA_MODE in Arca-back (docs/design-notes/DN-09 in that repo):
#   production  (default when absent) no banner, no debug panel, no debug code in the bundle
#   mock        MOCK banner, state panel and fault injection; the back must run in mock too
#   live-debug  LIVE DEBUG banner over the real APIs and database; accounts and billing are simulated in the
#               back's memory; the back must run in live-debug
# Any other value stops `next dev` and `next build`, and a Vercel build fails in any mode but production.
# This example starts a fresh checkout in mock. `npm run dev:mock`, `npm run dev:live-debug` and
# `npm run stack -- <mode>` (in Arca-back) set the mode themselves and win over this line.
NEXT_PUBLIC_ARCA_MODE=mock
