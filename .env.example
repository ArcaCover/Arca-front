# Copia este archivo a .env.local y rellena los valores reales.
# .env.local está ignorado por git: los valores reales NUNCA se suben al repositorio.

# URL del proyecto de Supabase (Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon" de Supabase (Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OPCIONAL. En producción no hace falta: por defecto se usa https://arcacover.com.
# Solo se rellena en previews o staging, para que la imagen que se ve al
# compartir el enlace apunte a ese entorno y no al dominio real.
# Formato: con https y sin barra final.
# Se deja comentada: vacía rompe todas las páginas (layout.tsx hace new URL("")).
# NEXT_PUBLIC_SITE_URL=

# Required explicit API origin. This isolated fork never falls back to production.
# Run the paired Arca-back checkout locally. No live API or paid service is needed.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Developer mode, same value as ARCA_MODE in Arca-back (docs/design-notes/DN-09 in that repo):
#   production  (default when absent) no banner, no debug panel, no debug code in the bundle
#   mock        MOCK banner, state panel and fault injection; the back must run in mock too
#   live-debug  LIVE DEBUG banner over the real APIs and database; the back must run in live-debug
# Any other value stops `next dev` and `next build`, and a Vercel build fails in any mode but production.
# This example starts a fresh checkout in mock. `npm run dev:mock`, `npm run dev:live-debug` and
# `npm run stack -- <mode>` (in Arca-back) set the mode themselves and win over this line.
NEXT_PUBLIC_ARCA_MODE=mock
