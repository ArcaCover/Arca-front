# Copia este archivo a .env.local y rellena los valores reales.
# .env.local está ignorado por git: los valores reales NUNCA se suben al repositorio.

# URL del proyecto de Supabase (Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon" de Supabase (Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dominio público del sitio, con https y sin barra final (ej. https://arca.com).
# Se usa para resolver la URL absoluta de la imagen que se ve al compartir el
# enlace. Si queda vacío, se usa http://localhost:3000 y la previsualización no
# funcionará fuera de tu máquina.
NEXT_PUBLIC_SITE_URL=
